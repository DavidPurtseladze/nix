{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Logo
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/assets/logos/katana.png",
    "width": 18,
    "height": 18,
    "preserveAspectRatio": true,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },

  // Layout
  "display": {
    "separator": "  "
  },

  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "─" },

    // System
    { "type": "os",       "key": "os  ", "keyColor": "magenta" },
    { "type": "kernel",   "key": "ker ", "keyColor": "magenta" },
    { "type": "uptime",   "key": "up  ", "keyColor": "magenta" },
    { "type": "packages", "key": "pkg ", "keyColor": "magenta" },
    { "type": "shell",    "key": "sh  ", "keyColor": "magenta" },
    { "type": "wm",       "key": "wm  ", "keyColor": "magenta" },

    "break",

    // Hardware
    { "type": "cpu",     "key": "cpu ", "keyColor": "blue" },
    { "type": "gpu",     "key": "gpu ", "keyColor": "blue" },
    { "type": "memory",  "key": "mem ", "keyColor": "blue" },
    { "type": "swap",    "key": "swp ", "keyColor": "blue" },
    { "type": "disk",    "key": "dsk ", "keyColor": "blue", "folders": "/" },
    { "type": "battery", "key": "bat ", "keyColor": "blue" },

    "break",
    { "type": "colors", "symbol": "circle" },
    "break"
  ]
}
